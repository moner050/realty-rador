APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# 클라우드 MySQL 접속 정보
MYSQL_HOST=your-cloud-mysql-host.com
MYSQL_PORT=3306
MYSQL_DATABASE=realty_radar
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password

# Redis 접속 정보
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 외부 API 서비스 키
PUBLIC_DATA_API_KEY=key
# 네이버 지도 OPEN API (NCP - Naver Cloud Platform Application Maps)
# NCP 콘솔 신청 주소: https://console.ncloud.com/naver-service/application
# (NCP 콘솔 등록 시 Web Dynamic Map 선택 후 웹 서비스 URL에 http://localhost:8000 등록 필수)
# Client ID (브라우저 지도 스크립트의 ncpKeyId 및 서버 헤더 x-ncp-apigw-api-key-id)
NAVER_MAP_CLIENT_ID=your_naver_map_client_id
# Client Secret (서버 지오코딩 헤더 x-ncp-apigw-api-key 전용, 브라우저에 노출 금지)
NAVER_MAP_CLIENT_SECRET=your_naver_map_client_secret

DATA_DIRECTORY=./data
AUTH_DIRECTORY=./data/auth
SNAPSHOT_DIRECTORY=./data/snapshots
SCREENSHOT_DIRECTORY=./data/screenshots

LOG_LEVEL=INFO

# 구글(Google) OAuth 2.0 간편 로그인 설정
# Google Cloud Console 주소: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

